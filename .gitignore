.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Gated/local model files must not be committed.
*.safetensors
*.bin
*.gguf
checkpoints/
models/

# Local credentials and generated executables.
.env
.env.*
!.env.example
token
token.txt
h2d_driver_bench

# Real experiment outputs: receipts/summaries are tracked, raw traces are not.
real_results/raw/
real_results/airllm/*.log
real_results/70b_int8/airllm_compression/*.log
real_results/70b_int8/airllm_compression/*.pid
real_results/70b_int8/airllm_compression/*.failed
real_results/70b_int8/airllm_compression/smoke_*.json
# Local chats can contain private prompts and are runtime state, not receipts.
real_results/70b_int8/chat_*.jsonl
real_results/70b_int8/chat_*session*.json
# Large per-layer numerical traces are local diagnostic intermediates. Keep
# their compact gate summaries and versioned contracts in the repository.
real_results/8b_w8a16/fused_decode_diagnostics.json
real_results/8b_w8a16/fused_decode_diagnostics_fp32_reference.json
real_results/8b_w8a16/fused_decode_diagnostics_golden_chongqing.json
real_results/8b_w8a16/fused_decode_diagnostics_golden_france.json
real_results/8b_w8a16/golden_v1/baseline_special_tokens.json
real_results/8b_w8a16/golden_v1/chinese_chongqing.json
real_results/8b_w8a16/golden_v1/english_france.json
*.nsys-rep
*.qdrep

# Locally compiled optional CUDA providers. Keep validated metadata reviewable.
layer_streaming/providers/*/_build/*
!layer_streaming/providers/*/_build/*.metadata.json

# Copy to .env.local. Never place HF_TOKEN or other credentials in this file.
# CASCADE_ROOT is detected automatically by scripts/activate_env.sh.
CASCADE_STORAGE_ROOT=/ssd/cascade-llm
CASCADE_MODEL_ROOT=/ssd/cascade-llm/models
CASCADE_LLAMA31_8B=/ssd/cascade-llm/models/Llama-3.1-8B-Instruct
CASCADE_MODEL_REPO=unsloth/Meta-Llama-3.1-8B-Instruct
CASCADE_MODEL_REVISION=a2856192dd7c25b842431f39c179a6c2c2f627d1
CASCADE_HF_ENDPOINT=https://hf-mirror.com
CASCADE_DOWNLOAD_WORKERS=4
HF_HOME=/ssd/cascade-llm/hf-cache
HF_HUB_CACHE=/ssd/cascade-llm/hf-cache/hub
UV_CACHE_DIR=/ssd/cascade-llm/uv-cache
UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple
UV_LINK_MODE=copy
TMPDIR=/ssd/cascade-llm/tmp

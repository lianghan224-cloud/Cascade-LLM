# Copy to .env.local and replace every path with a local absolute path.
# Never place credentials in this file or commit .env.local.
CASCADE_STORAGE_ROOT=/path/to/cascade-storage
CASCADE_MODEL_ROOT=/path/to/cascade-storage/models
CASCADE_LLAMA31_8B=/path/to/cascade-storage/models/Llama-3.1-8B-Instruct
CASCADE_MODEL_REPO=unsloth/Meta-Llama-3.1-8B-Instruct
CASCADE_MODEL_REVISION=a2856192dd7c25b842431f39c179a6c2c2f627d1
CASCADE_HF_ENDPOINT=https://huggingface.co
CASCADE_DOWNLOAD_WORKERS=4
HF_HOME=/path/to/cascade-storage/hf-cache
HF_HUB_CACHE=/path/to/cascade-storage/hf-cache/hub
UV_CACHE_DIR=/path/to/cascade-storage/uv-cache
UV_LINK_MODE=copy
TMPDIR=/path/to/cascade-storage/tmp
